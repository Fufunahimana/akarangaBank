@model IEnumerable<AkarangaBank.Web.Models.VirementInterAgence>
@{ ViewData["Title"] = "Virements inter-agences"; }
<partial name="_OperationsStyles" />

<section class="bank-page">
    <header class="bank-page-header"><div><h1>Virements inter-agences en attente</h1><p>@Model.Count() transfert(s) à traiter</p></div><div class="bank-actions"><a asp-action="Historique" class="bank-btn bank-btn-light">Historique</a><a asp-action="Initier" class="bank-btn bank-btn-primary">Nouveau virement</a></div></header>
    <div class="bank-page-body">
        @if (TempData["Success"] is string success) { <div class="bank-flash" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="bank-flash-error" role="alert">@error</div> }
        <div class="bank-table-wrap"><table class="bank-table">
            <thead><tr><th>Date</th><th>Référence</th><th>Agence source</th><th>Agence destination</th><th class="text-end">Montant</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
            @if (Model.Any())
            {
                @foreach (var v in Model)
                {
                    <tr><td>@BankTime.ToLocal(v.DateCreation).ToString("dd/MM/yyyy HH:mm")</td><td>@v.Reference</td><td>@v.AgenceSource.Code</td><td>@v.AgenceDestination.Code</td><td class="text-end">@v.Montant.ToString("N2") @v.Devise</td><td>@v.Statut</td><td>
                        @if (User.IsInRole("admin"))
                        {
                            <form asp-action="Valider" asp-route-id="@v.Id" method="post" class="d-inline"><button type="submit" class="bank-btn bank-btn-primary">Valider</button></form>
                            <form asp-action="Rejeter" asp-route-id="@v.Id" method="post" class="d-inline"><input type="hidden" name="motif" value="Rejeté par un administrateur" /><button type="submit" class="bank-btn bank-btn-secondary">Rejeter</button></form>
                        }
                    </td></tr>
                }
            }
            else { <tr><td colspan="7" class="bank-empty">Aucun virement en attente.</td></tr> }
            </tbody>
        </table></div>
    </div>
</section>
