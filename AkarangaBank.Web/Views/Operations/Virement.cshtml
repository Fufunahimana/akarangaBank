@model AkarangaBank.Web.ViewModels.VirementViewModel
@{ ViewData["Title"] = "Virement"; }
<partial name="_OperationsStyles" />

<section class="bank-page">
    <header class="bank-page-header">
        <div><h1>Virement</h1><p>Transférer des fonds entre deux comptes</p></div>
        <a asp-action="Journal" class="bank-btn bank-btn-light">Voir le journal</a>
    </header>
    <div class="bank-page-body">
        <div class="bank-flash-warning">Tout virement entre deux agences est enregistré en attente et doit être approuvé par un administrateur avant d’être comptabilisé.</div>
        @if (TempData["Success"] is string msg) { <div class="bank-flash" role="status">@msg</div> }
        <form asp-action="Virement" method="post" class="bank-form">
            <div asp-validation-summary="ModelOnly" class="bank-validation"></div>
            <div class="bank-form-group">
                <label asp-for="CompteSourceId" class="bank-label">Compte source</label>
                <select asp-for="CompteSourceId" asp-items="ViewBag.Comptes" class="bank-control">
                    <option value="">-- Sélectionner le compte source --</option>
                </select>
                <span asp-validation-for="CompteSourceId" class="bank-validation"></span>
            </div>
            <div class="bank-form-group">
                <label asp-for="CompteDestinationId" class="bank-label">Compte destination</label>
                <select asp-for="CompteDestinationId" asp-items="ViewBag.ComptesDestination" class="bank-control">
                    <option value="">-- Sélectionner le compte destinataire --</option>
                </select>
                <span asp-validation-for="CompteDestinationId" class="bank-validation"></span>
            </div>
            <div class="bank-form-group">
                <label asp-for="Montant" class="bank-label">Montant (BIF)</label>
                <input asp-for="Montant" class="bank-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="Montant" class="bank-validation"></span>
            </div>
            <div class="bank-form-group">
                <label asp-for="Motif" class="bank-label">Motif</label>
                <input asp-for="Motif" class="bank-control" />
                <span asp-validation-for="Motif" class="bank-validation"></span>
            </div>
            <div class="bank-actions">
                <button type="submit" class="bank-btn bank-btn-primary">Enregistrer le virement</button>
                <a asp-action="Journal" class="bank-btn bank-btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
