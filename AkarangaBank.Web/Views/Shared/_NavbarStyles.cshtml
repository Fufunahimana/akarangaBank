        border-radius: 7px;
        background: #fff;
        color: #495057;
        font-size: .82rem;
        font-weight: 650;
        line-height: 1.1;
        text-decoration: none;
        white-space: nowrap;
        transition: border-color .15s ease, background-color .15s ease, color .15s ease;
    }

    .bank-navbar .btn-bank-outline:hover {
        border-color: #0d6efd;
        background: #eaf2ff;
        color: #0b5ed7;
    }

    .bank-navbar .btn-bank-danger:hover {
        border-color: #dc3545;
        background: #fff5f5;
        color: #b02a37;
    }

    .bank-navbar-account.is-manage-page .btn-bank-outline {
        border-color: #cfe0ff;
        background: #eaf2ff;
        color: #0b5ed7;
    }

    .bank-navbar .btn-bank-danger {
        cursor: pointer;
    }

    .bank-logout-form {
        display: inline-flex;
        margin: 0;
    }

    .bank-2fa-badge {
        margin-left: 5px;
        padding: 2px 6px;
        border-radius: 999px;
        background: #d1e7dd;
        color: #0f5132;
        font-size: .67rem;
        font-weight: 700;
        vertical-align: middle;
    }

    .bank-layout-content {
        width: 100%;
        min-height: calc(100vh - 82px);
    }

    @@media (max-width: 1100px) {
        .bank-navbar-inner {
            gap: 9px 14px;
            padding: 11px 20px;
        }

        .bank-primary-nav {
            gap: 4px 5px;
        }

        .bank-nav-link {
            min-height: 38px;
            padding: 7px 8px;
            font-size: .82rem;
        }
    }

    @@media (max-width: 680px) {
        .bank-navbar-inner {
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 9px 12px;
            padding: 10px 14px;
        }

        .bank-brand-mark {
            width: 37px;
            height: 37px;
            border-radius: 9px;
        }

        .bank-brand-name {
            font-size: 1rem;
        }

        .bank-user-nav {
            gap: 7px;
        }

        .bank-user-summary {
            gap: 0;
        }

        .bank-user-copy,
        .bank-2fa-badge {
            display: none;
        }

        .bank-user-avatar {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
        }

        .bank-user-actions {
            gap: 5px;
        }

        .bank-navbar .btn-bank-outline,
        .bank-navbar .btn-bank-danger {
            min-height: 35px;
            padding: 7px 8px;
            font-size: .76rem;
        }

        .bank-primary-nav {
            grid-column: 1 / -1;
            grid-row: 2;
            flex-wrap: nowrap;
            justify-content: flex-start;
            gap: 4px;
            overflow-x: auto;
            overflow-y: hidden;
            margin-right: -14px;
            padding: 3px 14px 7px 0;
            scrollbar-width: thin;
        }

        .bank-nav-link {
            flex: 0 0 auto;
            min-height: 38px;
            padding: 8px 10px;
            font-size: .82rem;
        }
    }

    @@media (max-width: 450px) {
        .bank-navbar-inner {
            grid-template-columns: minmax(0, 1fr);
        }

        .bank-navbar-account {
            grid-column: 1;
            grid-row: 2;
            justify-self: stretch;
        }

        .bank-user-nav {
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 8px;
        }

        .bank-user-copy {
            display: grid;
        }

        .bank-user-name,
        .bank-user-email {
            max-width: min(48vw, 190px);
        }

        .bank-2fa-badge {
            display: inline-block;
        }

        .bank-user-actions {
            display: grid;
            flex: 1 0 100%;
            grid-template-columns: 1fr 1fr;
        }

        .bank-navbar .btn-bank-outline,
        .bank-navbar .btn-bank-danger {
            width: 100%;
            box-sizing: border-box;
        }

        .bank-primary-nav {
            grid-column: 1;
            grid-row: 3;
        }
    }
</style>
