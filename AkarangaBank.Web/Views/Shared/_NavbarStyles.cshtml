<style>
    .bank-navbar {
        position: relative;
        z-index: 20;
        width: 100%;
        border-bottom: 1px solid #dfe5ec;
        background: #fff;
        box-shadow: 0 4px 18px rgba(33, 37, 41, .06);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .bank-navbar-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px 20px;
        width: min(100%, 1680px);
        margin: 0 auto;
        padding: 12px 28px;
        box-sizing: border-box;
    }

    .bank-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        min-width: max-content;
        color: #172b4d;
        text-decoration: none;
    }

    .bank-brand:hover {
        color: #0b5ed7;
    }

    .bank-brand-mark {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        border-radius: 11px;
        background: linear-gradient(145deg, #0d6efd, #0b5ed7);
        box-shadow: 0 5px 12px rgba(13, 110, 253, .2);
        color: #fff;
        font-size: .9rem;
        font-weight: 800;
        letter-spacing: .04em;
    }

    .bank-brand-name {
        font-size: 1.12rem;
        font-weight: 750;
        letter-spacing: -.02em;
    }

    .bank-primary-nav {
        display: flex;
        grid-column: 1 / -1;
        grid-row: 2;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-start;
        gap: 5px 7px;
        min-width: 0;
        overflow: visible;
    }

    .bank-nav-link {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 40px;
        padding: 8px 10px;
        border-radius: 7px;
        color: #495057;
        font-size: .86rem;
        font-weight: 600;
        line-height: 1.2;
        text-decoration: none;
        white-space: nowrap;
        transition: background-color .15s ease, color .15s ease;
    }

    .bank-nav-icon {
        display: block;
        flex: 0 0 17px;
        width: 17px;
        height: 17px;
        color: #6b7b91;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: color .15s ease;
    }

    .bank-nav-link:hover,
    .bank-nav-link.is-active {
        background: #eaf2ff;
        color: #0b5ed7;
    }

    .bank-nav-link:hover .bank-nav-icon,
    .bank-nav-link.is-active .bank-nav-icon {
        color: #0b5ed7;
    }

    .bank-nav-link:focus-visible,
    .bank-brand:focus-visible,
    .bank-navbar a:focus-visible,
    .bank-navbar button:focus-visible {
        outline: 3px solid rgba(13, 110, 253, .35);
        outline-offset: 2px;
    }

    .bank-navbar-account {
        grid-column: 2;
        grid-row: 1;
        justify-self: end;
        min-width: 0;
    }

    .bank-user-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .bank-user-summary {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
    }

    .bank-user-avatar {
        display: grid;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        place-items: center;
        border: 1px solid #cfe0ff;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0b5ed7;
        font-size: .88rem;
        font-weight: 750;
    }

    .bank-user-copy {
        display: grid;
        min-width: 0;
        line-height: 1.25;
    }

    .bank-user-name {
        overflow: hidden;
        max-width: 150px;
        color: #212529;
        font-size: .84rem;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bank-user-email {
        overflow: hidden;
        max-width: 150px;
        margin-top: 3px;
        color: #6c757d;
        font-size: .74rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bank-user-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .bank-navbar .btn-bank-outline,
    .bank-navbar .btn-bank-danger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
