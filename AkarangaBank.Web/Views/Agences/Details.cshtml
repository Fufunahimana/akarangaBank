@model AkarangaBank.Web.ViewModels.AgenceDetailsViewModel

@{
    ViewData["Title"] = "Détails de l'agence";
    string msg = string.Empty;
    string msgLegacy = string.Empty;
}

<style>
    .bank-details-container {
        max-width: 800px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .bank-details-header {
        background-color: #0d6efd;
        color: white;
        padding: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .bank-details-header h2 {
        margin: 0;
        font-weight: 700;
        font-size: 1.75rem;
    }
    .bank-details-header p {
        margin: 5px 0 0;
        opacity: 0.85;
        font-size: 0.95rem;
    }
    .bank-details-body {
        padding: 30px;
    }
    .details-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }
    .details-table th, .details-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #dee2e6;
        font-size: 0.95rem;
    }
    .details-table th {
        width: 30%;
        background-color: #f8f9fa;
        color: #333;
        font-weight: 600;
        text-align: left;
    }
    .details-table td {
        color: #495057;
    }
    .stats-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }
    .stat-card {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
    }
    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0d6efd;
        margin-bottom: 5px;
    }
    .stat-label {
        font-size: 0.85rem;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
    }
    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 15px;
        border-left: 4px solid #0d6efd;
        padding-left: 10px;
    }
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        border-top: 1px solid #dee2e6;
        padding-top: 20px;
    }
    .btn-edit {
        background-color: #ffc107;
        color: #000;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s;
    }
    .btn-edit:hover {
        background-color: #ffca2c;
        color: #000;
    }
    .btn-back {
        background-color: #f8f9fa;
        color: #495057;
        border: 1px solid #ced4da;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s;
    }
    .btn-back:hover {
        background-color: #e2e6ea;
    }
</style>

<div class="bank-details-container">
    <div class="bank-details-header">
        <div>
            <h2>AkarangaBank</h2>
            <p>Détails de l'agence</p>
        </div>
    </div>

    <div class="bank-details-body">
        <!-- Informations principales -->
        <table class="details-table">
            <tr>
                <th>Code</th>
                <td><strong>@Model.Agence.Code</strong></td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>@Model.Agence.Nom</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>@Model.Agence.Ville</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>
                    @if (Model.Agence.EstSiege)
                    {
                        <span style="background-color: #0d6efd; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">Siège</span>
                    }
                    else
                    {
                        <span style="background-color: #6c757d; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">Agence</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Date de création</th>
                <td>@BankTime.ToLocal(Model.Agence.DateCreation).ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        </table>

        <!-- Activité de l'agence (Statistiques) -->
        <div class="section-title">Activité de l'agence</div>
        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-value">@Model.NombreClients</div>
                <div class="stat-label">Client(s)</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@Model.NombreComptes</div>
                <div class="stat-label">Compte(s)</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@Model.NombreUtilisateurs</div>
                <div class="stat-label">Utilisateur(s)</div>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="form-actions">
            <a asp-action="Index" class="btn-back">Retour à la liste</a>
            <a asp-action="Edit" asp-route-id="@Model.Agence.Id" class="btn-edit">Modifier</a>
        </div>
    </div>
</div>
