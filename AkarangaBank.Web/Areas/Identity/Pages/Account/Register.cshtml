@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<partial name="_AuthStyles" />

<div class="identity-auth-page">
    <header class="identity-auth-heading">
        <span class="identity-auth-eyebrow">AkarangaBank · Espace sécurisé</span>
        <h1>@ViewData["Title"]</h1>
        <p>Create your secure banking profile.</p>
    </header>

    <div class="identity-auth-grid">
        <section class="identity-auth-card" aria-labelledby="local-register-title">
            <div class="identity-auth-card-heading">
                <span class="identity-auth-icon" aria-hidden="true">AK</span>
                <div>
                    <h2 id="local-register-title">Create a new account.</h2>
                    <p>Enter your email and choose a strong password.</p>
                </div>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="identity-auth-form">
                <div asp-validation-summary="ModelOnly" class="identity-auth-validation" role="alert"></div>

                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button id="registerSubmit" type="submit" class="identity-auth-submit">
                    <span>Register</span>
                    <span aria-hidden="true">→</span>
                </button>

                <div class="identity-auth-links">
                    <p>Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
                </div>
            </form>
        </section>

        <aside class="identity-auth-sidecard" aria-labelledby="external-register-title">
            <span class="identity-auth-sidecard-mark" aria-hidden="true">●</span>
            <h2 id="external-register-title">Use another service to register.</h2>
            <p>Register with one of the connected services.</p>

            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="identity-auth-provider-empty">
                    <span class="identity-auth-empty-dot" aria-hidden="true"></span>
                    <span>
                        There are no external authentication services configured.
                        <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank" rel="noopener noreferrer">Learn how to configure one.</a>
                    </span>
                </div>
            }
            else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="identity-auth-providers">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" name="provider" value="@provider.Name" title="Register using your @provider.DisplayName account">
                            <span>@provider.DisplayName</span>
                            <span aria-hidden="true">→</span>
                        </button>
                    }
                </form>
            }

            <div class="identity-auth-security-note">
                <span aria-hidden="true">✓</span>
                <span>Your account is protected by AkarangaBank security.</span>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
