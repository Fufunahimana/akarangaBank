@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<partial name="_AuthStyles" />

<div class="identity-auth-page">
    <header class="identity-auth-heading">
        <span class="identity-auth-eyebrow">AkarangaBank · Espace sécurisé</span>
        <h1>@ViewData["Title"]</h1>
        <p>Connectez-vous à votre espace bancaire.</p>
    </header>

    <div class="identity-auth-grid">
        <section class="identity-auth-card" aria-labelledby="local-login-title">
            <div class="identity-auth-card-heading">
                <span class="identity-auth-icon" aria-hidden="true">AK</span>
                <div>
                    <h2 id="local-login-title">Use a local account to log in.</h2>
                    <p>Enter your account details to continue.</p>
                </div>
            </div>

            <form id="account" method="post" class="identity-auth-form">
                <div asp-validation-summary="ModelOnly" class="identity-auth-validation" role="alert"></div>

                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="identity-auth-options">
                    <label asp-for="Input.RememberMe" class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <span class="form-check-label">@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                    </label>
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                </div>

                <button id="login-submit" type="submit" class="identity-auth-submit">
                    <span>Log in</span>
                    <span aria-hidden="true">→</span>
                </button>

                <div class="identity-auth-links">
                    <p>New to AkarangaBank? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a></p>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                </div>
            </form>
        </section>

        <aside class="identity-auth-sidecard" aria-labelledby="external-login-title">
            <span class="identity-auth-sidecard-mark" aria-hidden="true">●</span>
            <h2 id="external-login-title">Use another service to log in.</h2>
            <p>Choose a connected service to access your account.</p>

            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div class="identity-auth-provider-empty">
                    <span class="identity-auth-empty-dot" aria-hidden="true"></span>
                    <span>There are no external authentication services configured.</span>
                </div>
            }
            else
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="identity-auth-providers">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            <span>@provider.DisplayName</span>
                            <span aria-hidden="true">→</span>
                        </button>
                    }
                </form>
            }

            <div class="identity-auth-security-note">
                <span aria-hidden="true">✓</span>
                <span>Your connection is protected by AkarangaBank security.</span>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
